# Copy to .env and fill in. .env is git-ignored: these links are private.
#
# Where the file goes:
#   browser mode (npm run dev / npm start) and npm run app:  ./.env (this folder)
#   desktop app, Linux:    ~/.config/TV Guide/.env
#   desktop app, Windows:  %APPDATA%\TV Guide\.env
# Variables set in the environment override the file.

# Gzipped XMLTV guide, used by "Update EPG" and the first-run download.
EPG_URL=https://example.com/epg.xml.gz

# M3U playlist with the channel streams, used by the Play buttons.
# Leave empty to hide the Play buttons.
PLAYLIST_URL=https://example.com/playlist.m3u8

# Decision model for "Recommend": llama.cpp's llama-server running a decision model such
# as H2O Lightning (it answers on /v1/systemone). Either point at one that's running, e.g.
# on another machine on your LAN, or let the app start its own (see README). Without
# either, Recommend is hidden. The prompt is in recommend-prompt.txt next to this file
# (created on first use).
LLM_URL=http://192.168.1.50:9931
# LLM_MODEL=                  # only if the server hosts several models
# LLM_API_KEY=                # if llama-server runs with --api-key
# LLM_TIMEOUT=120             # seconds per model call
# LLM_PARALLEL=1              # calls at once; match llama-server -np

# Or, with LLM_URL unset, the app runs llama-server itself, on 127.0.0.1 only. The model is
# LLM_MODEL_FILE, or the first .gguf in the "models" folder next to this file.
# LLM_MODEL_FILE=/path/to/h2o-lightning-4b-Q8_0.gguf
# LLAMA_SERVER=/path/to/llama-server   # default: the bundled one, then llama-server on PATH
# LLAMA_CTX=40960             # context per parallel slot (-c is this x LLM_PARALLEL)
# LLAMA_ARGS=-fa on           # more llama-server options
# RECOMMEND_BATCH=16          # programmes per question (2-255); more are ranked in rounds
# RECOMMEND_DESC_CHARS=600    # programme description length in the prompt

# Optional:
# VLC=/path/to/vlc            # found automatically on Linux and Windows
# PORT=3001                   # API port for browser mode
# HOST=127.0.0.1              # 0.0.0.0 exposes the API (and VLC launching) to your network
