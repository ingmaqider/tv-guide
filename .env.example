# Copy to .env and fill in. .env is git-ignored: these links are private.
#
# Where the file goes:
#   browser mode (npm run dev / npm start) and npm run app:  ./.env (this folder)
#   desktop app, Linux:    ~/.config/TV Guide/.env
#   desktop app, Windows:  %APPDATA%\TV Guide\.env
# Variables set in the environment override the file.

# Gzipped XMLTV guide, used by "Update EPG" and the first-run download.
EPG_URL=https://example.com/epg.xml.gz

# M3U playlist with the channel streams, used by the Play buttons.
# Leave empty to hide the Play buttons.
PLAYLIST_URL=https://example.com/playlist.m3u8

# Optional:
# VLC=/path/to/vlc            # found automatically on Linux and Windows
# PORT=3001                   # API port for browser mode
# HOST=127.0.0.1              # 0.0.0.0 exposes the API (and VLC launching) to your network
